# Rust build output
/target/

# Project Agent instructions and durable context are version-controlled.
# Generated local Agent indexes and caches remain excluded.
/.agents/
/.codegraph/
/.serena/

# Repository Codex marketplace is a version-controlled product surface.
!/.agents/
/.agents/*
!/.agents/plugins/
/.agents/plugins/*
!/.agents/plugins/marketplace.json
/.local-marketplace/

# Architecture and OpenSpec sources are version-controlled project inputs.
# Keep only generated or machine-specific evidence excluded below.

# Machine-specific J-Link and MCP configuration
/jlink-mcp.toml
/.mcp.json

# Local captures, validation evidence, and transient files
/.jlink-mcp/
/captures/
/validation/evidence/
/openspec/changes/*/evidence/
*.partial
*.log

# Editor and operating-system files
/.idea/
/.vscode/
.DS_Store
Thumbs.db
