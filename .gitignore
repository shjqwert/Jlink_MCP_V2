# Rust build output
/target/

# Local development context and generated indexes are not release sources.
/.agent/
/AGENTS.md
/.gitmessage
/.codegraph/
/.serena/

# Repository Codex marketplace is a version-controlled product surface.
/.agents/*
!/.agents/plugins/
/.agents/plugins/*
!/.agents/plugins/marketplace.json
/.local-marketplace/

# Keep design, experiments, independent tests and evidence on the developer's
# machine. Back them up separately; ignored files are not saved by future commits.
/architecture/
/openspec/
/experiments/
/validation/
/crates/*/tests/
/crates/*/examples/t_*.rs
/scripts/test-*.ps1
/scripts/check-test-fixtures.ps1
/scripts/t-*.jlink
/scripts/tests/

# Machine-specific J-Link and MCP configuration
/jlink-mcp.toml
/.mcp.json

# Local captures, validation evidence, and transient files
/.jlink-mcp/
/captures/
*.partial
*.log

# Editor and operating-system files
/.idea/
/.vscode/
.DS_Store
Thumbs.db
