model {
  agent = actor "Agent" {
    #reused
    description "Modern MCP client that consumes structuredContent and resource links."
  }

  v2Baseline = system "jlink-mcp-V2 As-Is" {
    #reused
    summary "The rewrite repository has no Rust implementation or runtime architecture yet."
    description "The legacy implementation has been removed from the V2 worktree. Only planning material is present; no executable Rust module boundary can yet be claimed as implemented."
    metadata {
      baselineStatus "confirmed"
      evidence ["openspec/config.yaml", "git status --short on 2026-08-24: legacy tracked implementation deleted"]
    }
  }

  jlinkDll = external "SEGGER J-Link x64 DLL" {
    #reused
    technology "J-Link 9.70 candidate baseline"
    description "External native dependency. The supported DLL path, version and file hash are project configuration."
  }

  target = device "ARM Cortex-M target" {
    #reused
    technology "SWD or JTAG"
  }

  jlinkDll -> target "debug and memory access"
}
